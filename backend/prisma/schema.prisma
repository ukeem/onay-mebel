// Onay Mebel — Prisma Schema
// ============================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  SUPER
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CalcType {
  SHEET // лист
  SQM // кв.м
  LM // м.п.
}

enum ProfitType {
  COEF // коэффициент
  FIXED // фиксированная
}

enum ContactType {
  WHATSAPP
  TELEGRAM
  EMAIL
  INSTAGRAM
  TIKTOK
}

enum FacadeOpenType {
  HANDLE // ручки
  TIP_ON // Tip-On (нажимной)
}

enum DrawerSlideType {
  GUIDE // направляющие
  TANDEM // тандем
}

// ============================================
// AUTH & USERS
// ============================================

model User {
  id          String     @id @default(cuid())
  role        Role       @default(USER)
  phone       String     @unique
  password    String
  status      UserStatus @default(INACTIVE)
  activeUntil DateTime?

  refreshTokens RefreshToken[]
  userMaterials UserMaterial[]
  userHardware  UserHardware[]
  userService   UserService?
  projects      Project[]
  companyInfo   CompanyInfo?
  paymentStages PaymentStage[]
  contacts      UserContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SmsCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([phone, used, expiresAt])
}

// ============================================
// CATALOG (admin templates)
// ============================================

model RoomType {
  id   String @id @default(cuid())
  name String

  rooms Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductType {
  id   String @id @default(cuid())
  name String

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaterialType {
  id   String @id @default(cuid())
  name String // ЛДСП, МДФ, ХДФ, Камень, Кромка...

  materials Material[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HardwareType {
  id   String @id @default(cuid())
  name String // петли, направляющие, полкодержатели...

  hardware Hardware[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExtraType {
  id    String @id @default(cuid())
  name  String // подсветка, доводчики, ножки...
  price Float  @default(0) // цена по умолчанию

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Material {
  id             String       @id @default(cuid())
  materialTypeId String
  materialType   MaterialType @relation(fields: [materialTypeId], references: [id], onDelete: Cascade)
  brand          String?
  calcType       CalcType     @default(SHEET)
  length         Int          @default(1) // mm (для SHEET)
  width          Int          @default(1) // mm (для SHEET)
  price          Decimal      @default(0)
  image          String?

  userMaterials    UserMaterial[]
  sectionBodies    ProductSection[]     @relation("SectionMaterial")
  sectionBackWalls ProductSection[]     @relation("SectionBackWallMaterial")
  partitionMat     ProductPartition[]   @relation("PartitionMaterial")
  shelfMat         ProductShelf[]       @relation("ShelfMaterial")
  drawerMat        ProductDrawer[]      @relation("DrawerMaterial")
  productFacades   ProductFacade[]
  falseFacadeMat   ProductFalseFacade[] @relation("FalseFacadeMaterial")
  countertopMat    ProductCountertop[]  @relation("CountertopMaterial")
  apronMat         ProductCountertop[]  @relation("ApronMaterial")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([materialTypeId])
}

model Hardware {
  id             String       @id @default(cuid())
  hardwareTypeId String
  hardwareType   HardwareType @relation(fields: [hardwareTypeId], references: [id], onDelete: Cascade)
  brand          String?
  price          Decimal      @default(0)
  image          String?

  userHardware UserHardware[]

  // Back-references for sub-component hardware
  sectionLegs   ProductSection[] @relation("SectionLegsHardware")
  facadeHinges  ProductFacade[]  @relation("FacadeHingeHardware")
  facadeHandles ProductFacade[]  @relation("FacadeHandleHardware")
  facadeTipOns  ProductFacade[]  @relation("FacadeTipOnHardware")
  shelfHolders  ProductShelf[]   @relation("ShelfHolderHardware")
  drawerSlides  ProductDrawer[]  @relation("DrawerSlideHardware")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hardwareTypeId])
}

model ServiceTemplate {
  id                  String     @id @default(cuid())
  sawingPrice         Decimal    @default(0) // Распил — цена за лист
  drillingPrice       Decimal    @default(0) // Присадка — цена за лист
  edgeBandingPrice    Decimal    @default(0) // Кромка — цена за м.п.
  technologistPercent Decimal    @default(5) // Технолог %
  designerPercent     Decimal    @default(5) // Дизайнер %
  assemblyPercent     Decimal    @default(10) // Сборка + монтаж %
  deliveryPrice       Decimal    @default(0) // Доставка — цена за 1 ед.
  profitType          ProfitType @default(COEF)
  profitValue         Decimal    @default(1.5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// USER SETTINGS (copy of catalog per user)
// ============================================

model UserMaterial {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  price      Decimal  @default(0)
  enabled    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, materialId])
}

model UserHardware {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hardwareId String
  hardware   Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)
  price      Decimal  @default(0)
  enabled    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, hardwareId])
}

model UserService {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sawingPrice         Decimal    @default(0)
  drillingPrice       Decimal    @default(0)
  edgeBandingPrice    Decimal    @default(0)
  technologistPercent Decimal    @default(5)
  designerPercent     Decimal    @default(5)
  assemblyPercent     Decimal    @default(10)
  deliveryPrice       Decimal    @default(0)
  profitType          ProfitType @default(COEF)
  profitValue         Decimal    @default(1.5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// COMPANY INFO, PAYMENT STAGES, CONTACTS
// ============================================

model CompanyInfo {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  logo          String? // путь к файлу логотипа
  name          String
  description   String?
  descriptionKz String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentStage {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageNumber Int // 1–5
  percentage  Int // %
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, stageNumber])
  @@index([userId])
}

model UserContact {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   ContactType
  value  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  clientData String?

  rooms        Room[]
  calculations Calculation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Room {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Product {
  id            String      @id @default(cuid())
  roomId        String
  room          Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  productTypeId String
  productType   ProductType @relation(fields: [productTypeId], references: [id])

  // ---- Свитчеры ----
  sectionsEnabled     Boolean @default(false)
  partitionsEnabled   Boolean @default(false)
  shelvesEnabled      Boolean @default(false)
  facadesEnabled      Boolean @default(false)
  falseFacadesEnabled Boolean @default(false)
  drawersEnabled      Boolean @default(false)
  countertopEnabled   Boolean @default(false)
  extrasEnabled       Boolean @default(false)

  // ---- Реляции на конфигурацию ----
  sections     ProductSection[]
  partitions   ProductPartition[]
  shelves      ProductShelf[]
  facades      ProductFacade[]
  falseFacades ProductFalseFacade[]
  drawers      ProductDrawer[]
  countertops  ProductCountertop[]
  extras       ProductExtra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
}

// ============================================
// PRODUCT CONFIGURATION
// ============================================

// Группа секций (Модуль: 2 боковины + крыша/дно + задняя стенка)
model ProductSection {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String?
  qty        Int       @default(1)
  width      Int       @default(0) // Ш mm
  height     Int       @default(0) // В mm
  depth      Int       @default(0) // Г mm
  materialId String?
  material   Material? @relation("SectionMaterial", fields: [materialId], references: [id])

  // Задняя стенка
  backWallEnabled    Boolean   @default(false)
  backWallMaterialId String?
  backWallMaterial   Material? @relation("SectionBackWallMaterial", fields: [backWallMaterialId], references: [id])

  // Ножки
  legsEnabled    Boolean   @default(false)
  legsHardwareId String?
  legsHardware   Hardware? @relation("SectionLegsHardware", fields: [legsHardwareId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Группа перегородок
model ProductPartition {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String?
  qty        Int       @default(1)
  height     Int       @default(0) // В mm
  depth      Int       @default(0) // Г mm
  materialId String?
  material   Material? @relation("PartitionMaterial", fields: [materialId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Группа полок
model ProductShelf {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String?
  qty        Int       @default(1)
  width      Int       @default(0) // Ш mm
  depth      Int       @default(0) // Г mm
  materialId String?
  material   Material? @relation("ShelfMaterial", fields: [materialId], references: [id])

  // Полкодержатели
  holderHardwareId String?
  holderHardware   Hardware? @relation("ShelfHolderHardware", fields: [holderHardwareId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Группа фасадов
model ProductFacade {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String?
  materialId String?
  material   Material?      @relation(fields: [materialId], references: [id])
  width      Int            @default(0) // Ш mm
  height     Int            @default(0) // В mm
  qty        Int            @default(1)
  handleQty  Int            @default(0)
  openType   FacadeOpenType @default(HANDLE)

  // Петли
  hingeHardwareId String?
  hingeHardware   Hardware? @relation("FacadeHingeHardware", fields: [hingeHardwareId], references: [id])

  // Ручки
  handleHardwareId String?
  handleHardware   Hardware? @relation("FacadeHandleHardware", fields: [handleHardwareId], references: [id])

  // Tip-On
  tipOnHardwareId String?
  tipOnHardware   Hardware? @relation("FacadeTipOnHardware", fields: [tipOnHardwareId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Группа ящиков
model ProductDrawer {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String?
  width      Int             @default(0) // Ш mm
  height     Int             @default(0) // В mm
  depth      Int             @default(0) // Г mm
  qty        Int             @default(1)
  handleQty  Int             @default(0)
  slideType  DrawerSlideType @default(GUIDE)
  materialId String?
  material   Material?       @relation("DrawerMaterial", fields: [materialId], references: [id])

  // Направляющие/Тандем (фурнитура)
  slideHardwareId String?
  slideHardware   Hardware? @relation("DrawerSlideHardware", fields: [slideHardwareId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Группа фальш-фасадов
model ProductFalseFacade {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String?
  qty        Int       @default(1)
  height     Int       @default(0) // В mm
  depth      Int       @default(0) // Г mm
  materialId String?
  material   Material? @relation("FalseFacadeMaterial", fields: [materialId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Группа столешниц + фартук
model ProductCountertop {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String?
  materialId String?
  material   Material? @relation("CountertopMaterial", fields: [materialId], references: [id])
  width      Int       @default(0) // Ш mm
  depth      Int       @default(600) // Г mm

  // Фартук
  apronEnabled    Boolean   @default(false)
  apronMaterialId String?
  apronMaterial   Material? @relation("ApronMaterial", fields: [apronMaterialId], references: [id])
  apronWidth      Int? // Ш mm
  apronHeight     Int? // В mm

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Дополнительные позиции (произвольные)
model ProductExtra {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String?
  name      String
  price     Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// ============================================
// CALCULATIONS (snapshot)
// ============================================

model Calculation {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Polный snapshot расчёта в JSON
  // Содержит: rooms[], products[], тарифы (standard/comfort/premium),
  // детализацию цен, услуги, итоги
  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}
