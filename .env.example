# ═══════════════════════════════════════════════
# .env.example — шаблон переменных окружения
# Скопируйте в .env и заполните реальными значениями
# ═══════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=onay_mebel

# ── Backend ──
PORT=4000
JWT_SECRET=change-me-random-string-32-chars
JWT_REFRESH_SECRET=change-me-another-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Super Admin (создаётся через seed) ──
SUPER_ADMIN_PHONE=+77000000000
SUPER_ADMIN_PASSWORD=change-me-admin-password

# ── Frontend (local dev only) ──
# BACKEND_URL=http://localhost:4000
