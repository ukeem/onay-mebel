# ──────────────────────────────────────────────
# Onay Mebel — переменные окружения
# Скопируйте в .env и заполните реальными значениями
# ──────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=onay_mebel

# ── Database URL (для backend) ──
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/onay_mebel

# ── JWT (минимум 16 символов каждый!) ──
JWT_SECRET=change-me-to-random-string-min-16
JWT_REFRESH_SECRET=change-me-to-another-random-string-min-16
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Super Admin (создаётся при seed) ──
SUPER_ADMIN_PHONE=+77001234567
SUPER_ADMIN_PASSWORD=changeme123

# ── Frontend URL (для CORS в production) ──
# Указать реальный домен с https://
FRONTEND_URL=https://your-domain.com

# ── Nginx (только для локального запуска без Dokploy) ──
# NGINX_PORT=80

# ── Domain (для Traefik/Dokploy TLS) ──
APP_DOMAIN=your-domain.com

# ── Uploads ──
UPLOAD_DIR=./uploads

# ── Тарифы (frontend, опционально) ──
NEXT_PUBLIC_PRICE_MONTHLY=25000
NEXT_PUBLIC_PRICE_YEARLY=240000

# ── Уведомления (Telegram) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
