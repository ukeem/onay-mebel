# ── Environment ──
NODE_ENV=development

# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=onay_mebel
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@localhost:5432/onay_mebel

# ── Backend ──
PORT=4000
JWT_SECRET=CHANGE_ME_min_16_chars_secret
JWT_REFRESH_SECRET=CHANGE_ME_min_16_chars_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
FRONTEND_URL=http://localhost:3000

# ── Super Admin (создаётся через seed) ──
SUPER_ADMIN_PHONE=+77000000000
SUPER_ADMIN_PASSWORD=CHANGE_ME_strong_pass

# ── Uploads ──
UPLOAD_DIR=./uploads

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
