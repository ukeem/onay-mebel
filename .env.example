# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=onay_mebel

# ── Backend ──
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/onay_mebel
PORT=4000
JWT_SECRET=change-me-random-string
JWT_REFRESH_SECRET=change-me-another-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
FRONTEND_URL=http://localhost:3000

# Super Admin (создаётся через seed)
SUPER_ADMIN_PHONE=+77000000000
SUPER_ADMIN_PASSWORD=admin12345

# Uploads
UPLOAD_DIR=./uploads

# ──────────────────────────────────────────────
# NEXT_PUBLIC_* переменные НЕ нужны в Docker!
# Фронтенд использует относительные URL (пустая строка).
# Для локальной разработки без Docker:
#   frontend/.env.local → NEXT_PUBLIC_API_URL=http://localhost:4000
# ──────────────────────────────────────────────
